PORT=3000
NODE_ENV=development
MONGO_USER=mithai
MONGO_PASSWORD=mithai_secret
MONGO_URI=mongodb://mithai:mithai_secret@localhost:27017/?authSource=admin
MONGO_DB_NAME=mithai_wale
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
# Platform super admin (admin-ui). Static credentials; login grants a
# non-refreshable access token valid for ADMIN_TOKEN_TTL_SECONDS (default 5 min).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_TOKEN_TTL_SECONDS=300
